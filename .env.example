# Copy to .env and adjust values. Keep .env out of git (it is already ignored).

# PostgreSQL connection used by Drizzle ORM, migrations, and the seed script.
# The host below points to the Kamkazi postgres container exposed on 127.0.0.1.
# In the Docker container the compose file overrides DATABASE_HOST to
# host.docker.internal so the container reaches the host database.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5434
DATABASE_NAME=nstarx_intake
DATABASE_USER=nstarx_app
DATABASE_PASSWORD=change_me

# Optional: force SSL for the connection. Leave unset or false for local dev.
DATABASE_SSL=false

# Admin seed passwords. These are hashed with scrypt before being stored.
# Pick strong values in any shared environment; they are not echoed or logged.
ADMIN_SHANTANU_PASSWORD=change_me
ADMIN_SUJAY_PASSWORD=change_me

# Secret used to HMAC-sign admin session cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET=change_me

# Session lifetime in seconds (default 24 hours).
SESSION_TTL_SECONDS=86400

# SendGrid email delivery. Leave SENDGRID_API_KEY empty to disable email (the
# app then logs a loud error and skips sending). A live key is required for the
# admin notification and the submitter confirmation to be delivered.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@nstarxinc.com

# Optional dev/test safety switch. When set, EVERY outbound message is redirected
# to this single address. Leave empty in production.
EMAIL_REDIRECT_TO=

# Assignee notification addresses (production: use real NStarX emails)
ASSIGNEE_SHANTANU_EMAIL=shantanu.chaturvedi@nstarxinc.com
ASSIGNEE_SUJAY_EMAIL=sujay@nstarxinc.com

# Admin notification recipients for new submissions and comments
ADMIN_NOTIFY_EMAILS=shantanu.chaturvedi@nstarxinc.com,sujay@nstarxinc.com

# Public base URL used for deep links in emails and the success page.
NEXT_PUBLIC_BASE_URL=https://intake.nstarxinc.com

# Upload destination for intake attachments. The container uid (1000) needs
# write access to this directory. A Docker volume mount is configured in
# docker-compose.yml for deployment.
UPLOAD_DIR=/mnt/hikvision/Shantanu/Work/NStarX-Intake-Uploads
